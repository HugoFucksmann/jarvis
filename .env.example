# JARVIS Configuration Example
# Ollama Local LLM Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TEMPERATURE=0.3

# Server Settings
PORT=3000
HOST=127.0.0.1

# Agent Execution Limits
AGENT_MAX_ITERATIONS=15
AGENT_TIMEOUT_SECONDS=180

# Feature Flags
MEMORY_ENABLED=true
WEB_SEARCH_ENABLED=true
VOICE_ENABLED=true
VOICE_MODEL=frozenlab/qwen3-asr:0.6b
VOICE_DEVICE=cpu
VISION_ENABLED=true
VISION_MODEL=qwen2.5-vl:7b
VISION_DEVICE=gpu
VISION_MAX_WIDTH=1920
VISION_QUALITY=85

# Wake Word Passive Detection Settings
WAKE_WORD_ENABLED=true
WAKE_WORD_KEYWORDS=hey jarvis,jarvis,oye jarvis,hola jarvis
WAKE_WORD_AUTO_DISMISS=12

# Security & Permissions
AUTO_APPROVE_LOW_RISK=true
AUTO_APPROVE_MEDIUM_RISK=false
AUTO_APPROVE_HIGH_RISK=false

# Workspace Root
WORKSPACE_ROOT=.

# Telegram
TELEGRAM_TOKEN=8255134608:AAFeG1XULXIn-zO8FTwU_HfrPNfN4_EyYXY